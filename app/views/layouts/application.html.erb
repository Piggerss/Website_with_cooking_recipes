<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Мои рецепты" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Мои рецепты">
    <meta name="mobile-web-app-capable" content="yes">

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
  </head>

  <body>
    <header class="site-header">
      <div class="site-header__content">
        <%= link_to "Мои рецепты", root_path, class: "site-name" %>
        <nav aria-label="Навигация">
          <%= link_to "Главная", root_path, class: "nav-link #{'nav-link--active' if controller_path == 'recipes' && action_name == 'home'}" %>
          <%= link_to "Все рецепты", recipes_path, class: "nav-link #{'nav-link--active' if controller_path == 'recipes' && action_name == 'index'}" %>
          <%= link_to "Админка", admin_recipes_path, class: "nav-link #{'nav-link--active' if controller_path == 'admin/recipes'}" %>
          <% if admin_signed_in? %>
            <form action="<%= logout_path %>" method="post" class="nav-logout">
              <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
              <input type="submit" value="Выйти">
            </form>
          <% end %>
        </nav>
      </div>
    </header>

    <% if flash.any? %>
      <% flash.each do |key, message| %>
        <div class="flash <%= key %>"><%= message %></div>
      <% end %>
    <% end %>

    <main class="page"><%= yield %></main>
  </body>
</html>
