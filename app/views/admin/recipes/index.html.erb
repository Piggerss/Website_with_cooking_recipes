<% content_for :title, "Админка — рецепты" %>

<section class="admin-heading">
  <h1>Админка — рецепты</h1>
  <%= link_to "Добавить рецепт", new_admin_recipe_path, class: "button" %>
</section>

<div class="table-wrap">
  <table>
    <thead>
      <tr>
        <th>Название</th>
        <th>Категория</th>
        <th>Время</th>
        <th>Действие</th>
      </tr>
    </thead>
    <tbody>
      <% @recipes.each do |recipe| %>
        <tr>
          <td><%= recipe.title %></td>
          <td><%= recipe.category.name %></td>
          <td><%= recipe.cooking_time %> мин.</td>
          <td>
            <%= button_to "Удалить", admin_recipe_path(recipe),
                  method: :delete,
                  class: "button button--danger",
                  data: { turbo_confirm: "Удалить рецепт?" } %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
